<%- include("../partials/head", { title: title }) %>

  <body>
    <%- include("../partials/userNav") %>
      <div class="space">
        <h1 class="homes">Available Homes 🏡</h1>
        <div class="cardLayoutContainer">
          <% if (items.length===0) { %>
            <p>No homes added yet.</p>
            <% } else { %>
              <% items.forEach((item)=> { %>
                <div class="homesCardContainer">
                  <div class="topContainer">
                    <img class="homeImage" src="<%= item.image_link%>" alt="Home image">
                  </div>

                  <div class="bottomContainer">
                    <div class="topItem">
                      <div class="providerName">
                        <%= item.name %>
                      </div>
                      <div class="rating">⭐<%= item.rating %>
                      </div>
                    </div>
                    <div class="homeLocation">
                      <%= item.location %>
                    </div>
                    <div class="priceContainer">
                      <div class="realPrice">Rs<%= item.price %>
                      </div>
                      <div class="priceBar">/</div>
                      <div class="night">night</div>
                    </div>

                    <div class="buttonContainer">
                      <a href="/User-homes/<%= item.home_id %>" class="detailsButton">Details</a>
                      <a class="bookButton">Book</a>
                      <form method="post" action="/User/User-favourite/<%= item.home_id %>" class="favForm">
                        <button type="submit" class="favouriteButton">Favourite</button>
                      </form>
                    </div>
                  </div>
                </div>
                <% }) %>
                  <% } %>
        </div>
        <%- include("../partials/footer") %>
  </body>

  </html>