<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %>
    </title>
    <link rel="stylesheet" href="/css/custom.css">
</head>

<body>
    <%- include("../partials/userNav") %>
        <div class="favHomeContainer">
            <div class="page-header">
                <h1>Your Favourite Homes ❤️</h1>
                <p>Here are the properties you loved.</p>
            </div>

            <% if (favouriteHomes.length===0) { %>
                <center>
                    <h1 class="nofavhomeMess">You don’t have any favourite homes yet.</h1>
                </center>
                <% } else { %>
                    <div class="cardsContainer">
                        <% favouriteHomes.forEach((newItems)=>{%>
                            <div class="favHomeCardContainer">
                                <img src="<%=newItems.image_link%>" alt="<%=newItems.Name%>" width="100%">

                                <div class="bottomContainer">
                                    <div class="NameandRatingContainer">
                                        <h2>
                                            <%= newItems.name%>
                                        </h2>
                                        <div>
                                            ⭐<%= newItems.rating%>
                                        </div>
                                    </div>
                                    <div class="LocationContainer1">
                                        📍 <%= newItems.location %>

                                    </div>
                                    <div class="priceremoveContainer">
                                        <div class="priceContainer1">

                                            <div class="priceRate">Rs<%= newItems.price %>
                                            </div>
                                            <div class="slash">/</div>
                                            <div class="night">night</div>

                                        </div>
                                        <button class="remove-btn" data-id="<%=newItems.home_id%>">Remove</button>

                                    </div>


                                </div>
                            </div>
                            <%})%>
                                <%}%>
                    </div>

        </div>
        <%- include("../partials/footer") %>
            <script src="/js/removefav.js"></script>
</body>

</html>