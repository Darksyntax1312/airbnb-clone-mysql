<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %>
    </title>
    <link rel="stylesheet" href="/css/custom2.css">
    <link rel="stylesheet" href="/css/custom.css">
    <!-- Google Font -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
</head>

<body>
    <%- include("../partials/userNav") %>

        <div class="detailshomeContainer">
                <div class="home-card">

                    <div class="card-image">
                       
                        <img class="homesImage" src="<%=items.image_link%>" alt="Beautiful Home">
                    </div>

                    <!-- RIGHT SIDE: Details -->
                    <div class="card-details">

                        <div class="header-row">
                            <h2>
                                <%=items.name %>
                            </h2>
                            <div class="rating">⭐ <%=items.rating%>
                            </div>
                        </div>

                        <p class="location">📍 <%=items.location%>
                        </p>

                        <div class="price-tag">
                            <span class="price">Rs<%=items.price%></span> / night
                        </div>

                        <hr class="divider">

                        <div class="description">
                            <h3>About this home</h3>
                            <p>
                                <%=items.details%>
                            </p>
                        </div>

                        <div class="contact-row">
                            <p class="phone">📞 <%= items.phone_number %></p>
                            <button class="book-btn">Book Now</button>
                        </div>

                    </div>
                </div>
            </div>

</body>

</html>